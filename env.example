# Copy these names into Vercel: Project, Settings, Environment Variables.
# Never commit real keys to GitHub.

# Required for real prices (twelvedata.com)
TWELVEDATA_KEY=

# Needed for AI analysis (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: choose a different Claude model (default claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Optional, for accounts (supabase.com). See README.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: email alerts when the page is closed (needs the accounts setup above). See README.
# Supabase Project Settings, API, "service_role" key. Server only: never put this anywhere in the page.
SUPABASE_SERVICE_KEY=
# resend.com API key and the address emails come from, e.g. Signal Desk <alerts@yourdomain.com>
RESEND_API_KEY=
MAIL_FROM=
# Any long random text. It protects the /api/cron address from strangers.
CRON_SECRET=
# Optional: how many symbols each scheduled check loads (default 8, matching free Twelve Data limits)
CRON_MAX_SYMBOLS=
